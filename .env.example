# Google Gemini API (Free - get from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face (Free - get from https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=your_hf_api_key_here

# LinkedIn API (get from https://www.linkedin.com/developers/)
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_PERSON_URN=urn:li:person:YOUR_PERSON_ID

# Instagram Graph API (via Meta Developer - https://developers.facebook.com)
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id

# RapidAPI (Free tier - https://rapidapi.com)
RAPIDAPI_KEY=your_rapidapi_key_here

# ImgBB (Free - https://imgbb.com - needed for Instagram image uploads)
IMGBB_API_KEY=your_imgbb_api_key_here
